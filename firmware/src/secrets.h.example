// CHROMAWOTD — Secrets template
//
// Copy this file to firmware/src/secrets.h and fill in your values.
// NEVER commit secrets.h to version control. It is gitignored.
//
// OPTIONAL NOW: the device can be configured entirely over its first-boot captive
// portal (join the "ChromaWOTD-XXXXXX" network, open http://192.168.4.1), which
// stores the values in NVS on the device. Use this file when you would rather bake
// a configuration in at build time — it is the middle rung of the resolution order:
//
//     NVS (portal)  >  secrets.h (this file)  >  built-in defaults
//
// so a device provisioned over the portal ignores what is here, and a factory reset
// falls back to it.
//
// This file contains:
//   - Wi-Fi credentials (SSID, passphrase)
//   - Location coordinates (latitude, longitude) and POSIX timezone
//
// Values are compiled into the firmware image. That means a binary built with a
// filled-in secrets.h CONTAINS THEM IN PLAINTEXT, so never publish such an image —
// the release workflow builds from a clean checkout (no secrets.h) for exactly this
// reason, and tools/merge_firmware.py refuses to package an image carrying them.

#pragma once

// Wi-Fi credentials. Leave these commented out to build an unprovisioned image that
// boots straight into the setup portal.
// #define WIFI_SSID "your_wifi_ssid"
// #define WIFI_PASSPHRASE "your_wifi_passphrase"

// Location and timezone (POSIX TZ string, DST-aware).
// #define CHROMAWOTD_LATITUDE -37.8528
// #define CHROMAWOTD_LONGITUDE 145.1633
// #define CHROMAWOTD_TIMEZONE "AEST-10AEDT,M10.1.0,M4.1.0/3"

// Optional: device name on the LAN (DHCP hostname + mDNS). Default "ChromaWOTD".
// #define CHROMAWOTD_HOSTNAME "ChromaWOTD"
