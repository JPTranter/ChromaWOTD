.pio/
build/
**/build/
# CMake build dirs for the alternate (device-font) host configuration
**/build-*/
output/
**/output/*.png
*.png.tmp

# Never commit Wi-Fi creds, API keys or location settings. The device also takes
# them from NVS at runtime; the template (secrets.h.example) is the only one that
# belongs in version control.
secrets.h
secrets.ini
.env
.env.*
!.env.example
*.pem
*.key

.vscode/
*.log
*.pdf
docs/hardware/datasheets/*.pdf
firmware/build_s3.log
firmware/*.log

# Python bytecode caches (auto-generated; never commit)
__pycache__/
*.py[cod]

# Virtualenvs
.venv/
venv/

# Release build output (merged flash images, generated by tools/merge_firmware.py)
release/
firmware/compile_commands.json
